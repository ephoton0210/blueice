{
  "id": "runtype-esnext-d1",
  "form": "d1",
  "entry": "main.tsx",
  "rootFiles": [
    "main.tsx"
  ],
  "runtimeModule": "ESNext",
  "options": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "declaration": true,
    "noEmitOnError": true,
    "newLine": "lf",
    "jsx": "react-jsxdev",
    "jsxImportSource": "typed-ui",
    "rootDir": ".",
    "outDir": "out"
  }
}
