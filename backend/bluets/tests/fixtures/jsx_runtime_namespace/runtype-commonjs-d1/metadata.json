{
  "id": "runtype-commonjs-d1",
  "form": "d1",
  "entry": "main.tsx",
  "rootFiles": [
    "main.tsx"
  ],
  "runtimeModule": "CommonJS",
  "options": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "strict": true,
    "declaration": true,
    "noEmitOnError": true,
    "newLine": "lf",
    "jsx": "react-jsxdev",
    "jsxImportSource": "typed-ui",
    "rootDir": ".",
    "outDir": "out"
  }
}
