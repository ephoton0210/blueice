{
  "scope": "Separately authored BlueTS ownership controls, zero Native inventory credit. Native calibrates semantic verdict/diagnostics/artifacts only; retirement, tamper, refusal and state identity are separate policy requirements.",
  "options": {
    "lib": [
      "ES5"
    ],
    "strict": true,
    "declaration": true,
    "noEmitOnError": true,
    "rootDir": ".",
    "outDir": "dist"
