{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "declaration": true,
    "noEmitOnError": true,
    "outDir": "out",
    "lib": [
      "ES2020"
    ],
    "removeComments": true,
    "newLine": "LF",
    "emitBOM": false,
    "inlineSources": false,
    "stripInternal": true
  },
  "files": [
    "main.ts"
  ]
}
