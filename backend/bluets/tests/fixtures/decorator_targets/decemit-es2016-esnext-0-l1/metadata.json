{
  "form": "l1",
  "options": {
    "target": "ES2016",
    "module": "ESNext",
    "lib": [
      "ES2020"
    ],
    "strict": true,
    "noImplicitThis": false,
    "declaration": true,
    "noEmitOnError": true,
    "useDefineForClassFields": false,
    "newLine": "LF",
    "outDir": "out",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": false
  }
}
