{
  "form": "s4",
  "options": {
    "target": "ES2018",
    "module": "CommonJS",
    "lib": [
      "ES2020"
    ],
    "strict": true,
    "noImplicitThis": false,
    "declaration": true,
    "noEmitOnError": true,
    "useDefineForClassFields": false,
    "newLine": "LF",
    "outDir": "out",
    "experimentalDecorators": false,
    "emitDecoratorMetadata": false
  }
}
