{
  "compilerOptions": {
    "target": "ES2016",
    "module": "CommonJS",
    "lib": [
      "ES2020"
    ],
    "strict": true,
    "noImplicitThis": false,
    "declaration": true,
    "noEmitOnError": true,
    "useDefineForClassFields": true,
    "newLine": "LF",
    "outDir": "out",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": false
  },
  "files": [
    "main.ts"
  ]
}
