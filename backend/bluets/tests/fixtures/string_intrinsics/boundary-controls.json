{
  "schema": 1,
  "scope": "Separate BlueTS ambient-owner/runtime-authority/configured-resource policy controls. Excluded from direct Native agreement. Authored before production changes.",
  "controls": [
    {
      "id": "uppercase-ambient-owner",
      "kind": "ambient-owner",
      "declaration": "type Uppercase<T> = { owner: T };",
      "source": "export const value: Uppercase<number> = { owner: 1 };",
      "expected": {
        "diagnostics": 0,
        "projectModules": [
          "memory:///main.ts",
          "memory:///owner.d.ts"
        ]
      }
    },
    {
      "id": "uppercase-runtime-authority",
      "kind": "runtime-authority",
      "source": "export const value = Uppercase(\"word\");",
      "expected": {
        "rejected": true,
        "published": false
      }
    },
    {
      "id": "uppercase-zero-work",
      "kind": "resource-limit",
      "source": "export const value: Uppercase<\"word\"> = \"WORD\";",
      "limited": {
        "max_type_expansions": 0
      },
      "expected": {
        "normalAccepted": true,
        "limitedCode": "ResourceLimit",
        "nativeCounterpart": null,
        "published": false
      }
    },
    {
      "id": "uppercase-one-work",
      "kind": "resource-limit",
      "source": "export const value: Uppercase<Uppercase<Uppercase<\"word\">>> = \"WORD\";",
      "limited": {
        "max_type_expansions": 1
      },
      "expected": {
        "normalAccepted": true,
        "limitedCode": "ResourceLimit",
        "nativeCounterpart": null,
        "published": false
      }
    },
    {
      "id": "uppercase-parser-depth",
      "kind": "resource-limit",
      "source": "export const value: Uppercase<Uppercase<Uppercase<\"word\">>> = \"WORD\";",
      "limited": {
        "parser.max_type_depth": 1
      },
      "expected": {
        "normalAccepted": true,
        "limitedCode": "ResourceLimit",
        "nativeCounterpart": null,
        "published": false
      }
    },
