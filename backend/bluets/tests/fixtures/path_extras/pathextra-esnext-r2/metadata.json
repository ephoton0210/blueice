{
  "id": "pathextra-esnext-r2",
  "form": "r2",
  "entry": "src/main.ts",
  "rootFiles": [
    "src/main.ts"
  ],
  "runtimeModule": "ESNext",
  "options": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "declaration": true,
    "noEmitOnError": true,
    "newLine": "LF",
    "rootDir": ".",
    "outDir": "out",
    "rootDirs": [
      "src",
      "generated"
    ]
  }
}
