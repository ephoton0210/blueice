{
  "id": "pathextra-esnext-t2",
  "form": "t2",
  "entry": "main.ts",
  "rootFiles": [
    "main.ts"
  ],
  "runtimeModule": "ESNext",
  "options": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "declaration": true,
    "noEmitOnError": true,
    "newLine": "LF",
    "rootDir": ".",
    "outDir": "out",
    "types": [
      "globals"
    ]
  }
}
