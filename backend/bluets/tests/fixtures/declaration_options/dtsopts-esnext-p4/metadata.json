{
  "id": "dtsopts-esnext-p4",
  "form": "p4",
  "options": {
    "target": "ES2022",
    "module": "ESNext",
    "strict": true,
    "declaration": true,
    "noEmitOnError": true,
    "newLine": "lf",
    "outDir": "out",
    "declarationDir": "types",
    "emitDeclarationOnly": true,
    "declarationMap": true
  }
}
