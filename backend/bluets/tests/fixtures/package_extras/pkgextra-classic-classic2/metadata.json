{
  "id": "pkgextra-classic-classic2",
  "form": "classic2",
  "entry": "src/main.ts",
  "rootFiles": [
    "src/main.ts"
  ],
  "runtimeModule": "CommonJS",
  "options": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "classic",
    "strict": true,
    "declaration": true,
    "noEmitOnError": true,
    "newLine": "LF",
    "rootDir": ".",
    "outDir": "out"
  }
}
