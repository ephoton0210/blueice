    "import json from './x.json' with { type: 'json' }; import text from './x.txt' with { type: 'text' }; import bytes from './x.bin' with { type: 'bytes' };",
    "import defer * as ns from './d.js'; import source s from './s.wasm';",
    "export var a = 1, b = 2; export let c = 3; export const d = 4; export function e() { } export class F { } export function* g() { } export async function h() { }",
    "var a, b; export { a, b as c, a as d }; export { e as default }; var e;",
    "export default function () { } ",
    "export default function f() { } ",
    "export default class { }",
    "export default class C { }",
    "export default async function () { }",
    "export default 1 + 2;",
    "export * from './a.js'; export * as ns from './b.js'; export { x, y as z } from './c.js'; export { default } from './d.js'; export { default as w } from './e.js';",
    "export * from './a.json' with { type: 'json' };",
    "export const [a, b] = [1, 2], { c, d: [e] } = { c: 1, d: [2] };",
    "@dec export class C { } function dec() { }",
    "@dec class C { } export { C } function dec() { }",
    "export @dec class C { } function dec() { }",
    "await 1; for await (var x of []) { } var y = await import('./a.js');",
    "class C { #p = 1; m() { return this.#p; } } export { C };",
    "import.meta.url; import.meta;",
    "import { 'string name' as a } from './a.js'; export { a as 'other name' };",
    "let a; let a;",
    "import a from './a.js'; var a;",
    "export { a }; export { a }; var a;",
    "function f() { super.x; }",
    "super();",
    "class C { m() { this.#missing; } }",
