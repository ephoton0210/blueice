    ";;;",
    "debugger;",
    "'use strict'; var yield_ = 1;",
    "var let_ = 1; let\n[a] = [1];",
    "label: function f() { }",
    "eval('var a = 1'); (0, eval)('var b = 2');",
    "new.target; ",
    "function f() { new.target; }",
    "import('x'); import('x', {});",
    "`a${1}b${2}c`; tag`a${1}`; String.raw`\\n`;",
    "a = { x, y, [z]: 1, ...w, get g() { return 1; }, set g(v) { }, async *m() { }, 'q'() { } }; var x, y, z, w;",
    "a = [1, , 2, ...[3]]; a = [, ]; a = [];",
    "a = b?.c?.[d]?.(e); var a, b, c, d, e;",
    "a = typeof b; a = delete c.d; a = void 0; a = !b; a = -b; a = +b; a = ~b; var a, b, c; ",
    "var a = 1; a++; ++a; a--; --a; var b = { c: 1 }; b.c++; b['c']--;",
    "var [a = 1] = [], { b = 2 } = {}; [a, b] = [b, a]; ({ a, b } = { a: 1, b: 2 }); [a = 1, [b] = [2]] = [];",
    "var o = { a: 1 }; ({ a: o.b, ...o.c } = o); [o.d, ...o.e] = [1, 2, 3];",
];
