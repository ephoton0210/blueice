// Source programs exercising the statement and pattern grammar. Shared by the
// parse-prefix and compile-budget sweeps, so each one is a whole valid program.
const SCRIPTS: &[&str] = &[
    // declarations and patterns
    "var a = 1, [b, , c = 2, ...d] = [1, 2, 3], { e, f: g = 3, h: [i], ...j } = { e: 1 };",
    "let [k = 1, [l] = [2], { m } = { m: 3 }, ...[n]] = [1]; const { o, 'p': q, 0: r, [1 + 1]: s, t = 4 } = {};",
    "var { let: x } = { let: 1 }; var [let_ = 1] = [];",
    "for (var [a, b] = [1, 2]; a < b; a++) { }",
    "for (let { a, b } of [{ a: 1, b: 2 }]) { }",
    "for (const [a, b = 2] in { x: 1 }) { }",
    "for (var a in { x: 1 }) ; for (a of [1]) ; for ({ a, b: [c] } of [{ a: 1, b: [2] }]) ; for ([a, b] in { xy: 1 }) ;",
    "for (var i = 0, n = 3; i < n; i++) { if (i) continue; else break; }",
    "for (;;) { break; } for (let i = 0; i < 1; i++) ; for (i = 0; i < 1; ) { i++ }",
    "for (var a in { x: 1 }) { for (var b of [1]) { break; } }",
    "outer: for (var i = 0; i < 2; i++) { inner: for (var j = 0; j < 2; j++) { if (j) continue outer; else break inner; } }",
    "a: b: c: while (false) { break a; }",
    "a: { break a; } b: if (true) { break b; }",
    "while (false) ; do ; while (false); do { } while (false)",
    "switch (1) { case 1: var x = 1; break; case 2: { let y = 2; } default: x = 3; }",
    "switch (1) { default: case 1: }",
    "switch (1) { }",
    "try { throw 1 } catch (e) { } finally { }",
    "try { } catch ({ message, code = 1 }) { }",
    "try { } catch ([a, b]) { } try { } catch { }",
    "try { } finally { }",
    "if (1) { } else if (2) { } else { }",
    "if (1) function f() { } else function g() { }",
    "function f() { if (1) function g() { } }",
    "with ({ a: 1 }) { a; } with ({}) ;",
    "with ({ a: 1 }) var b = a;",
    "var a = (1, 2, 3); a = a ? 1 : 2; a += 1; a ||= 1; a &&= 2; a ??= 3;",
    "throw new Error('x');",
    // functions
    "function f(a, b = 1, [c, d] = [1, 2], { e } = {}, ...rest) { return a + b + c + d + e + rest.length; }",
    "function f(a) { 'use strict'; return a; }",
    "function* g(a) { yield a; yield* [1, 2]; var x = yield; return x; }",
    "async function f(a) { await a; return await a; }",
    "async function* h() { yield 1; yield* [1]; await 1; for await (var x of [1]) { } return 1; }",
    "var f = function () { }; var g = function* () { }; var h = async function () { }; var i = async () => 1; var j = () => { };",
    "var f = (a, [b], { c }, d = 1, ...e) => a; var g = async (a) => { await a; };",
    "(function () { return arguments.length; })(); (function f() { return f; })();",
    "function f() { return; } function g() { return 1; } function h() { }",
    "function f() { var x = 1; { let x = 2; } return x; } function g() { let y = 1; { var z = 2; } }",
    "function f() { return function () { return this; }; }",
    "function f() { try { return 1; } finally { return 2; } }",
    "function f() { for (var x of [1]) { try { return x; } finally { } } }",
    "function* g() { try { yield 1; } finally { yield 2; } }",
    "function* g() { for (var x of [1]) { yield x; } }",
    "function f() { label: { break label; } }",
    "async function f() { try { await 1; } catch (e) { await e; } finally { await 1; } }",
    // strict tail calls
    "'use strict'; function f(n) { return n ? f(n - 1) : 0; }",
    "'use strict'; function f(n) { return n && f(n - 1); }",
    "'use strict'; function f(n) { return n || f(n - 1); }",
    "'use strict'; function f(n) { return n ?? f(n - 1); }",
    "'use strict'; function f(n) { return (n, f(n - 1)); }",
    "'use strict'; function f(n) { return (f(n - 1)); }",
    "'use strict'; function f(n) { return n ? (n ? f(n - 1) : 1) : g(n); } function g(n) { return n; }",
    "'use strict'; function f(n) { return g(n); } function g(n) { return n; }",
    "'use strict'; function f(n) { return g`x${n}`; } function g(s, n) { return n; }",
    "'use strict'; function f(n) { return f(...[n]); }",
    "'use strict'; function f(n) { for (var x of [1]) { return f(n); } }",
    "'use strict'; function f(n) { return n?.g(1); }",
    "'use strict'; function f(n) { return f?.(n); }",
    "'use strict'; class C { constructor() { return g(); } m() { return this.m(); } } function g() { return {}; }",
    "'use strict'; function* g() { return g(); } async function h() { return h(); }",
    "'use strict'; function f(n) { return n ? f(n - 1) : (n, 1); }",
    "'use strict'; function f(a, b) { return f(a + 1, b + 1); }",
    // classes
    "class A { }",
    "class A { constructor() { } m() { } static s() { } get g() { return 1; } set g(v) { } static get sg() { return 1; } static set sg(v) { } }",
    "class A { x = 1; 'y' = 2; 3 = 3; [4] = 4; static z = 5; #p = 6; static #q = 7; ['a' + 'b'] = 8; }",
    "class A { m() { return this.#p; } #p = 1; #m() { } get #g() { return 1; } set #g(v) { } static #s() { } static { this.x = 1; } }",
    "class A { #x = 1; static has(o) { return #x in o; } }",
    "class A extends Object { constructor() { super(); super.x; } m() { return super.m(); } static s() { return super.s; } }",
    "class A extends (class { }) { }",
    "var A = class { }; var B = class Named { }; var C = class extends A { };",
    "class A { accessor x = 1; static accessor y = 2; accessor #z = 3; accessor [1] = 4; }",
    "class A { static async *ag() { } async am() { } *gm() { } static async sam() { } }",
    "class A { static #a = 1; static { A.#a; } static b = A.#a; }",
    "@dec class A { }",
    "@dec1 @dec2(1) class A { @field x = 1; @method m() { } @getter get g() { return 1; } @auto accessor y; @dec static s() { } @priv #p = 1; }",
    "var d = (v) => v; @d class A { @d x = 1; @d static y = 2; @d m() { } @d accessor z; }",
    "var d = (v) => v; var A = @d class { @d x = 1; };",
    "class A { x = () => this; y = function () { }; z = class { }; [w] = 1; static [v] = 2; } var w, v;",
    "class A { 'constructor'() { } }",
    // explicit resource management
    "{ using a = null; }",
    "async function f() { await using a = null; }",
    "function f() { using a = { [Symbol.dispose]() { } }, b = null; return 1; }",
    "async function f() { await using a = { [Symbol.asyncDispose]() { } }; using b = null; }",
    "for (using a of [null]) { }",
    "async function f() { for (await using a of [null]) { } }",
    "function f() { { using a = null; { using b = null; } } }",
    // named function expressions: self tail calls
    "'use strict'; var g = function f(n) { return n ? f(n - 1) : 0; };",
    "'use strict'; var g = function f(n) { return n && f(n - 1); };",
    "'use strict'; var g = function f(n) { return n || f(n - 1); };",
    "'use strict'; var g = function f(n) { return n ?? f(n - 1); };",
    "'use strict'; var g = function f(n) { return (n, f(n - 1)); };",
    "'use strict'; var g = function f(n) { return n ? (n ? f(n - 1) : 1) : h(n); }; function h(n) { return n; }",
    "'use strict'; var g = function f(n) { for (var x of [1]) { return f(n); } };",
    "'use strict'; var g = function f(n) { for (var x in { a: 1 }) { for (var y of [1]) { return f(n); } } };",
    "'use strict'; var g = function f(a, b) { return f(a + 1, b + 1); };",
    "'use strict'; var g = function f(n) { return f(...[n]); };",
    "'use strict'; var g = function f(n) { switch (n) { case 1: return f(n - 1); default: return 0; } };",
    "'use strict'; var g = function f(n) { try { return f(n); } finally { } };",
    "'use strict'; var g = function f(n) { { using a = null; return f(n); } };",
    "'use strict'; var g = function f(n) { while (n) { return f(n - 1); } };",
    "'use strict'; var g = function f(n) { label: { return f(n); } };",
    // class expression statements, computed fields with anonymous functions
    "(class { });",
    "(class C { static x = 1; });",
    "class A { [k] = function () { }; static [k] = () => 1; [k] = class { }; } var k = 'a';",
    "class A { 'x' = function () { }; 1 = () => 1; 2n = 0; }",
    "class A { static #p = 1; static m() { return A.#p; } #q() { } static { A.#p = 2; } }",
    // sloppy direct eval declaring the same function twice
    "(function () { eval('function g() { return 1 }'); eval('function g() { return 2 }'); return g(); })();",
    "function f() { eval('var v = 1'); eval('var v = 2'); { function inner() { } } return v; }",
    "function f(a) { { function a() { } } if (a) { function b() { } } switch (a) { case 1: function c() { } } }",
    "if (1) function f() { } else function g() { }",
    "for (var i in { a: 1 }) function h() { }",
    "label: function f() { }",
    "async function f() { label: { break label; } for await (var x of []) { continue; } }",
    // labelled statements of every kind
    "a: do { break a; } while (0);",
    "a: switch (1) { case 1: break a; }",
    "a: for (var x in { a: 1 }) { continue a; }",
    "a: for (var x of [1]) { break a; }",
    "a: for (;;) { break a; }",
    "a: b: while (0) ;",
    "a: { b: { break a; } }",
    "a: try { break a; } finally { }",
    "a: if (1) break a; else ;",
    "a: { c: for (var i = 0; i < 1; i++) { continue c; } }",
