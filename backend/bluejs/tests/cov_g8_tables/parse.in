const PARSE_CASES: &[(&str, &str)] = &[
    (r#"P:async function f() { var \u0061wait; }"#, r#"ParseError { message: "the await keyword cannot contain an escape (found Identifier(\"await\"))", resource: None, known_syntax: true }"#),
    (r#"P:function* g() { var yi\u0065ld; }"#, r#"ParseError { message: "the yield keyword cannot contain an escape (found Identifier(\"yield\"))", resource: None, known_syntax: true }"#),
    (r#"P:async function f() { var aw\u{61}it; }"#, r#"ParseError { message: "the await keyword cannot contain an escape (found Identifier(\"await\"))", resource: None, known_syntax: true }"#),
    (r#"P:function* g() { var yi\u{65}ld; }"#, r#"ParseError { message: "the yield keyword cannot contain an escape (found Identifier(\"yield\"))", resource: None, known_syntax: true }"#),
    (r#"P:async function f() { var {\u0061wait} = {}; }"#, r#"ParseError { message: "the await keyword cannot contain an escape (found Punct(RBrace))", resource: None, known_syntax: true }"#),
    (r#"P:function* g() { var {yi\u0065ld} = {}; }"#, r#"ParseError { message: "the yield keyword cannot contain an escape (found Punct(RBrace))", resource: None, known_syntax: true }"#),
    (r#"P:async function f() { var [aw\u0061it] = []; }"#, r#"ParseError { message: "the await keyword cannot contain an escape (found Identifier(\"await\"))", resource: None, known_syntax: true }"#),
    (r#"M:var aw\u0061it;"#, r#"ParseError { message: "the await keyword cannot contain an escape (found Identifier(\"await\"))", resource: None, known_syntax: true }"#),
    (r#"P:class C { static { var aw\u0061it; } }"#, r#"ParseError { message: "await cannot be bound directly in a class static block (found Identifier(\"await\"))", resource: None, known_syntax: true }"#),
    (r#"P:async function f() { var await; }"#, r#"ParseError { message: "await cannot be used as a binding identifier in an async function or module (found Identifier(\"await\"))", resource: None, known_syntax: true }"#),
    (r#"P:function* g() { var yield; }"#, r#"ParseError { message: "yield cannot be used as a binding identifier in a generator function (found Identifier(\"yield\"))", resource: None, known_syntax: true }"#),
    (r#"P:var [a, ...b, c] = [];"#, r#"ParseError { message: "a binding rest element must be final (found Punct(Comma))", resource: None, known_syntax: true }"#),
    (r#"P:var { a, ...b, c } = {};"#, r#"ParseError { message: "a binding rest property must be final (found Punct(Comma))", resource: None, known_syntax: true }"#),
    (r#"P:var [...] = [];"#, r#"ParseError { message: "expected a binding target (identifier, '[', or '{') (found Punct(RBracket))", resource: None, known_syntax: true }"#),
    (r#"P:var { a: } = {};"#, r#"ParseError { message: "expected a binding target (identifier, '[', or '{') (found Punct(RBrace))", resource: None, known_syntax: true }"#),
    (r#"P:var { #a } = {};"#, r#"ParseError { message: "a private name is not a property key here (found PrivateIdentifier(\"a\"))", resource: None, known_syntax: true }"#),
    (r#"P:var { 'a' } = {};"#, r#"ParseError { message: "expected a binding identifier in destructuring pattern (found Punct(RBrace))", resource: None, known_syntax: true }"#),
    (r#"P:var { [a } = {};"#, r#"ParseError { message: "expected RBracket (found Punct(RBrace))", resource: None, known_syntax: true }"#),
    (r#"P:'use strict'; var { '\01': a } = {};"#, r#"ParseError { message: "legacy octal and non-octal decimal literals and escapes are not valid in strict mode (found String(JsString([1])))", resource: None, known_syntax: true }"#),
    (r#"P:'use strict'; var { 01: a } = {};"#, r#"ParseError { message: "legacy octal and non-octal decimal literals and escapes are not valid in strict mode (found Number(1.0))", resource: None, known_syntax: true }"#),
    (r#"P:var { a b } = {};"#, r#"ParseError { message: "expected Comma (found Identifier(\"b\"))", resource: None, known_syntax: true }"#),
    (r#"P:var [a b] = [];"#, r#"ParseError { message: "expected Comma (found Identifier(\"b\"))", resource: None, known_syntax: true }"#),
    (r#"P:var [a = ] = [];"#, r#"ParseError { message: "expected an expression (found Punct(RBracket))", resource: None, known_syntax: true }"#),
    (r#"P:var { a: [b = ] } = {};"#, r#"ParseError { message: "expected an expression (found Punct(RBracket))", resource: None, known_syntax: true }"#),
    (r#"P:var { a: b = } = {};"#, r#"ParseError { message: "expected an expression (found Punct(RBrace))", resource: None, known_syntax: true }"#),
    (r#"P:var { a = } = {};"#, r#"ParseError { message: "expected an expression (found Punct(RBrace))", resource: None, known_syntax: true }"#),
    (r#"P:var { 1n: a } = {};"#, r#"ok"#),
    (r#"P:var { let: a } = {};"#, r#"ok"#),
    (r#"P:var {} = 1; var [] = [];"#, r#"ok"#),
    (r#"P:var { a: b = 1, c = 2, ...d } = {}; var [e = 1, , f, ...g] = [];"#, r#"ok"#),
    (r#"P:var [a, ...b] = [], [...c] = [], { ...d } = {};"#, r#"ok"#),
    (r#"P:var { 'a': b, 1: c, 1n: d, [e]: f } = {}; var e;"#, r#"ok"#),
    (r#"M:let a; let a;"#, r#"ParseError { message: "duplicate module lexical declaration (found Eof)", resource: None, known_syntax: true }"#),
    (r#"M:import a from './a.js'; var a;"#, r#"ParseError { message: "module lexical declaration conflicts with a var declaration (found Eof)", resource: None, known_syntax: true }"#),
    (r#"M:export { a }; export { a }; var a;"#, r#"ParseError { message: "duplicate exported name (found Eof)", resource: None, known_syntax: true }"#),
    (r#"M:export { a, a as b, b as a }; var a, b;"#, r#"ParseError { message: "duplicate exported name (found Eof)", resource: None, known_syntax: true }"#),
    (r#"M:function f() { super.x; }"#, r#"ParseError { message: "a normal function cannot contain super (found Eof)", resource: None, known_syntax: true }"#),
    (r#"M:function f() { super(); }"#, r#"ParseError { message: "a normal function cannot contain super (found Eof)", resource: None, known_syntax: true }"#),
    (r#"M:class C { m() { this.#missing; } }"#, r#"ParseError { message: "private name is not declared in an enclosing class (found Eof)", resource: None, known_syntax: true }"#),
    (r#"M:export default function () { } export default 1;"#, r#"ParseError { message: "duplicate exported name (found Eof)", resource: None, known_syntax: true }"#),
    (r#"M:var eval; import { arguments } from './a.js';"#, r#"ParseError { message: "module import binds eval or arguments (found Eof)", resource: None, known_syntax: true }"#),
    (r#"M:import { a } from './a.js'; import { a } from './b.js';"#, r#"ParseError { message: "duplicate module lexical declaration (found Eof)", resource: None, known_syntax: true }"#),
    (r#"M:class A {} class A {}"#, r#"ParseError { message: "duplicate module lexical declaration (found Eof)", resource: None, known_syntax: true }"#),
    (r#"M:function f() {} function f() {}"#, r#"ParseError { message: "duplicate module lexical declaration (found Eof)", resource: None, known_syntax: true }"#),
    (r#"M:export default function f() {} function f() {}"#, r#"ParseError { message: "duplicate module lexical declaration (found Eof)", resource: None, known_syntax: true }"#),
    (r#"M:@dec class {} function dec() {}"#, r#"ParseError { message: "class declarations require a name (found Keyword(Function))", resource: None, known_syntax: true }"#),
    (r#"M:@dec export class {} function dec() {}"#, r#"ParseError { message: "class declarations require a name (found Keyword(Function))", resource: None, known_syntax: true }"#),
    (r#"M:export { default } from './a.js'; export { x as default } from './b.js';"#, r#"ParseError { message: "duplicate exported name (found Eof)", resource: None, known_syntax: true }"#),
    (r#"M:class C { #a; m() { super.#a; } }"#, r#"ParseError { message: "super cannot access a private element (found Punct(Semicolon))", resource: None, known_syntax: true }"#),
    (r#"M:var a; { let a; } function g() { var a; }"#, r#"ok"#),
    (r#"M:let x; export { x }; export { x as y }; export * from './a.js'; export * as ns from './b.js';"#, r#"ok"#),
    (r#"M:const a = 1; let b; class D {} function f() {} export default class {}"#, r#"ok"#),
    (r#"P:class C { #a; m() { super.#a; } }"#, r#"ParseError { message: "super cannot access a private element (found Punct(Semicolon))", resource: None, known_syntax: true }"#),
    (r#"P:class C { m() { this.#missing; } }"#, r#"ParseError { message: "private name is not declared in an enclosing class (found Eof)", resource: None, known_syntax: true }"#),
    (r#"P:class C { #a; #a; }"#, r#"ParseError { message: "duplicate private name in class body (found Eof)", resource: None, known_syntax: true }"#),
];
