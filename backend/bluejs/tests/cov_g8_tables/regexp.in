const REGEXP_CASES: &[(&str, &str)] = &[
    (r#"/\s/.exec('a b').index"#, r#"1"#),
    (r#"/\s+/.exec('a \t b')[0].length"#, r#"3"#),
    (r#"/\w/.exec('--a')[0]"#, r#"a"#),
    (r#"/\w+/.exec('--abc--')[0]"#, r#"abc"#),
    (r#"/\W+/.exec('ab--c')[0]"#, r#"--"#),
    (r#"/\W/.exec('ab-')[0]"#, r#"-"#),
    (r#"/\d/.exec('ab5c')[0]"#, r#"5"#),
    (r#"/\D+/.exec('12ab3')[0]"#, r#"ab"#),
    (r#"/\S+/.exec('  ab  ')[0]"#, r#"ab"#),
    (r#"/\S/.exec('  ab  ')[0]"#, r#"a"#),
    (r#"/^\d+$/.test('')"#, r#"false"#),
    (r#"/^\d+$/.test('123')"#, r#"true"#),
    (r#"/^\s+$/.test(' \t\n')"#, r#"true"#),
    (r#"/^\s+$/.test(' x')"#, r#"false"#),
    (r#"/^\w+$/.test('ab_9')"#, r#"true"#),
    (r#"/^\W+$/.test('!?')"#, r#"true"#),
    (r#"/^\W+$/.test('!?a')"#, r#"false"#),
    (r#"/^\S+$/.test('ab')"#, r#"true"#),
    (r#"/^\D+$/.test('ab1')"#, r#"false"#),
    (r#"(function () { var r = /^\d+$/g; r.lastIndex = 1; return r.exec('123') })()"#, r#"null"#),
    (r#"(function () { var r = /\d/g; r.lastIndex = 5; return r.exec('123') })()"#, r#"null"#),
    (r#"/\d/.exec('abc')"#, r#"null"#),
    (r#"/\.+/.exec('a..')[0]"#, r#".."#),
    (r#"/^\.+$/.test('..')"#, r#"true"#),
    (r#"/\b/.test('a')"#, r#"true"#),
    (r#"/\D/u.exec('😀')[0].length"#, r#"2"#),
    (r#"/\D/u.exec('\ud83dx')[0].length"#, r#"1"#),
    (r#"/\D/u.exec('\ud83d')[0].length"#, r#"1"#),
    (r#"/\D/u.exec('\ude00')[0].length"#, r#"1"#),
    (r#"/\d+/i.exec('12')[0]"#, r#"12"#),
    (r#"/\d+/m.exec('12')[0]"#, r#"12"#),
    (r#"/\d+/y.exec('12')[0]"#, r#"12"#),
    (r#"/^\d+$/v.test('12')"#, r#"true"#),
    (r#"/\D/v.exec('😀')[0].length"#, r#"2"#),
    (r#"new RegExp('(?<a\\u0062>x)').exec('x').groups.ab"#, r#"x"#),
    (r#"new RegExp('(?<a\\u{62}>x)').exec('x').groups.ab"#, r#"x"#),
    (r#"new RegExp('(?<a\\u00zz>x)')"#, r#"throws SyntaxError: Invalid token at named capture group identifier"#),
    (r#"new RegExp('(?<a\\u\ud800bcd>x)')"#, r#"throws SyntaxError: Invalid token at named capture group identifier"#),
    (r#"/(a)(b)?/.exec('xab') && [RegExp.$1, RegExp.$2, RegExp.$3, RegExp['$&'], RegExp['$+'], RegExp['$`'], RegExp["$'"], RegExp.input, RegExp.lastMatch, RegExp.lastParen, RegExp.leftContext, RegExp.rightContext].join('|')"#, r#"a|b||ab|b|x||xab|ab|b|x|"#),
    (r#"/(a)|(b)/.exec('b') && [RegExp.$1, RegExp.$2, RegExp.lastParen].join('|')"#, r#"|b|b"#),
    (r#"/a/.exec('b') === null && RegExp.lastMatch"#, r#""#),
];
