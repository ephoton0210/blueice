// Expected results are BlueJS's own.
const ITERATOR_CASES: &[(&str, &str)] = &[
    (r#"[1, 2, 3].values().map(x => x * 2).toArray().join()"#, r#"2,4,6"#),
    (r#"[1, 2, 3].values().filter(x => x > 1).toArray().join()"#, r#"2,3"#),
    (r#"[1, 2, 3].values().take(2).toArray().join()"#, r#"1,2"#),
    (r#"[1, 2, 3].values().drop(1).toArray().join()"#, r#"2,3"#),
    (r#"[1, 2, 3].values().flatMap(x => [x, x]).toArray().join()"#, r#"1,1,2,2,3,3"#),
    (r#"[1, 2, 3].values().reduce((a, b) => a + b, 0)"#, r#"6"#),
    (r#"[1, 2, 3].values().reduce((a, b) => a + b)"#, r#"6"#),
    (r#"[1, 2, 3].values().some(x => x > 2)"#, r#"true"#),
    (r#"[1, 2, 3].values().every(x => x > 2)"#, r#"false"#),
    (r#"[1, 2, 3].values().find(x => x > 1)"#, r#"2"#),
    (r#"[1, 2, 3].values().forEach(x => x)"#, r#"undefined"#),
    (r#"[1, 2, 3].values().chunks(2).toArray().join('|')"#, r#"1,2|3"#),
    (r#"[1, 2, 3].values().windows(2).toArray().join('|')"#, r#"1,2|2,3"#),
    (r#"[1, 2, 3].values().includes(2)"#, r#"true"#),
    (r#"[1, 2, 3].values().join('-')"#, r#"1-2-3"#),
    (r#"Iterator.from({ next() { return { done: true } } }).toArray().length"#, r#"0"#),
    (r#"Iterator.zip([[1, 2].values(), [3, 4].values()]).toArray().join('|')"#, r#"1,3|2,4"#),
    (r#"Iterator.zip([[1, 2].values(), [3].values()], { mode: 'longest', padding: [0, 9] }).toArray().join('|')"#, r#"1,3|2,9"#),
    (r#"Iterator.zip([[1, 2].values(), [3].values()], { mode: 'strict' }).toArray().join('|')"#, r#"throws TypeError: Iterator.zip strict sources have different lengths"#),
    (r#"Iterator.zipKeyed({ a: [1, 2].values(), b: [3, 4].values() }).toArray().map(x => JSON.stringify(x)).join('|')"#, r#"{"a":1,"b":3}|{"a":2,"b":4}"#),
    (r#"Iterator.concat([1].values(), [2].values()).toArray().join()"#, r#"1,2"#),
    (r#"[1, 2, 3].values().take(-1)"#, r#"throws RangeError: invalid Iterator.take limit"#),
    (r#"[1, 2, 3].values().take(NaN)"#, r#"throws RangeError: invalid Iterator.take limit"#),
    (r#"[1, 2, 3].values().chunks(0)"#, r#"throws RangeError: invalid Iterator.chunks size"#),
    (r#"[1, 2, 3].values().windows(0)"#, r#"throws RangeError: invalid Iterator.windows size"#),
    (r#"[1, 2, 3].values().chunks(2 ** 32)"#, r#"throws RangeError: invalid Iterator.chunks size"#),
    (r#"[1, 2, 3].values().map(5)"#, r#"throws TypeError: Iterator helper callback must be callable"#),
    (r#"Iterator.zip([[1].values()], { mode: 'bogus' })"#, r#"throws TypeError: invalid Iterator.zip mode"#),
    (r#"Iterator.zip(5)"#, r#"throws TypeError: Iterator.zip iterables must be an object"#),
    (r#"Iterator.zipKeyed(5)"#, r#"throws TypeError: Iterator.zipKeyed iterables must be an object"#),
    (r#"Iterator.concat(5)"#, r#"throws TypeError: Iterator.concat requires object arguments"#),
    (r#"Iterator.from(5)"#, r#"throws TypeError: Iterator.from requires an object or String"#),
    (r#"Iterator.from('abc').toArray().join()"#, r#"a,b,c"#),
    (r#"[1, 2, 3].values().windows(2, 'only-full').toArray().join('|')"#, r#"1,2|2,3"#),
    (r#"[1, 2, 3].values().windows(4, 'only-full').toArray().length"#, r#"0"#),
    (r#"[1, 2, 3].values().windows(4, 'allow-partial').toArray().join('|')"#, r#"1,2,3"#),
    (r#"[1, 2, 3].values().windows(2, 'bogus')"#, r#"throws TypeError: Iterator.windows undersized mode is invalid"#),
    (r#"[1, 2, 3].values().windows(2, 5)"#, r#"throws TypeError: Iterator.windows undersized mode is invalid"#),
    (r#"[1, 2, 3].values().windows(NaN)"#, r#"throws TypeError: Iterator.windows size must be an integral Number"#),
    (r#"[1, 2, 3].values().windows(2 ** 32)"#, r#"throws RangeError: invalid Iterator.windows size"#),
    (r#"[1].values().flatMap(x => 5).toArray()"#, r#"throws TypeError: Iterator.flatMap mapper must return an object"#),
    (r#"[1].values().flatMap(x => 'ab').toArray()"#, r#"throws TypeError: Iterator.flatMap mapper must return an object"#),
    (r#"[1].values().flatMap(x => ({})).toArray()"#, r#"throws TypeError: value is not callable"#),
    (r#"Iterator.zip([5]).toArray()"#, r#"throws TypeError: Iterator.flatMap mapper must return an object"#),
    (r#"Iterator.zip([[1].values()], { padding: 5 }).toArray().join('|')"#, r#"1"#),
    (r#"Iterator.zip([[1].values()], { mode: 'longest', padding: 5 })"#, r#"throws TypeError: Iterator.zip padding must be an object"#),
    (r#"Iterator.zip([[1].values()], { mode: 'longest', padding: [1, 2] }).toArray().join('|')"#, r#"1"#),
    (r#"Iterator.zip([[1, 2].values(), [3].values()], { mode: 'longest' }).toArray().join('|')"#, r#"1,3|2,"#),
    (r#"Iterator.zip([[1].values()], 5)"#, r#"throws TypeError: Iterator.zip options must be an object"#),
    (r#"Iterator.zip([[1].values()], { mode: 'shortest' }).toArray().join('|')"#, r#"1"#),
    (r#"Iterator.zip({ [Symbol.iterator]() { return 5 } })"#, r#"throws TypeError: Iterator.zip iterable method must return an object"#),
    (r#"Iterator.zip({ [Symbol.iterator]: 5 })"#, r#"throws TypeError: property is not callable"#),
    (r#"Iterator.zipKeyed({ a: [1, 2].values(), b: [3].values() }, { mode: 'longest', padding: { a: 0 } }).toArray().map(x => JSON.stringify(x)).join('|')"#, r#"{"a":1,"b":3}|{"a":2}"#),
    (r#"Iterator.zipKeyed({ a: [1, 2].values(), b: [3].values() }, { mode: 'longest' }).toArray().map(x => JSON.stringify(x)).join('|')"#, r#"{"a":1,"b":3}|{"a":2}"#),
    (r#"Iterator.zipKeyed({ a: [1, 2].values(), b: [3].values() }, { mode: 'longest', padding: 5 })"#, r#"throws TypeError: Iterator.zip padding must be an object"#),
    (r#"Iterator.zipKeyed({ a: [1].values() }, { mode: 'bogus' })"#, r#"throws TypeError: invalid Iterator.zip mode"#),
    (r#"Iterator.zipKeyed({ a: 5 }).toArray()"#, r#"throws TypeError: Iterator.flatMap mapper must return an object"#),
    (r#"Iterator.zipKeyed({ [Symbol('s')]: [1].values(), a: [2].values() }).toArray().length"#, r#"1"#),
    (r#"Iterator.zipKeyed(Object.create({ inherited: [1].values() }, { own: { value: [2].values(), enumerable: false }, shown: { value: [3].values(), enumerable: true } })).toArray().map(x => JSON.stringify(x)).join()"#, r#"{"shown":3}"#),
    (r#"Iterator.concat({ [Symbol.iterator]: 5 })"#, r#"throws TypeError: property is not callable"#),
    (r#"Iterator.concat({ [Symbol.iterator]() { return 5 } }).toArray()"#, r#"throws TypeError: Iterator.concat iterator method must return an object"#),
    (r#"Iterator.concat().toArray().length"#, r#"0"#),
    (r#"Iterator.from({ next: 5 }).next()"#, r#"throws TypeError: value is not callable"#),
    (r#"Iterator.from({ [Symbol.iterator]() { return 5 } })"#, r#"throws TypeError: Iterator.from iterator method must return an object"#),
    (r#"Iterator.from({ [Symbol.iterator]() { return { next() { return { value: 1, done: false } } } } }).take(2).toArray().join()"#, r#"1,1"#),
    (r#"(function () { var w = Iterator.from({ next() { return { value: 1, done: false } } }); return typeof w.return + w.return().done })()"#, r#"functiontrue"#),
    (r#"(function () { var w = Iterator.from({ next() { return { value: 1, done: false } }, return() { return { done: true, value: 7 } } }); return JSON.stringify(w.return()) })()"#, r#"{"done":true,"value":7}"#),
    (r#"Iterator.prototype.map.call(5, x => x)"#, r#"throws TypeError: Iterator helper requires an object receiver"#),
    (r#"Iterator.prototype.take.call(5, 1)"#, r#"throws TypeError: Iterator helper requires an object receiver"#),
    (r#"Iterator.prototype.flatMap.call(5, x => x)"#, r#"throws TypeError: Iterator helper requires an object receiver"#),
    (r#"Iterator.prototype.chunks.call(5, 1)"#, r#"throws TypeError: Iterator.chunks requires an object receiver"#),
    (r#"Iterator.prototype.windows.call(5, 1)"#, r#"throws TypeError: Iterator.windows requires an object receiver"#),
    (r#"Iterator.prototype.filter.call(5, x => x)"#, r#"throws TypeError: Iterator helper requires an object receiver"#),
    (r#"Iterator.prototype.drop.call(5, 1)"#, r#"throws TypeError: Iterator helper requires an object receiver"#),
    (r#"Iterator.prototype.toArray.call(5)"#, r#"throws TypeError: Iterator helper requires an object receiver"#),
    (r#"Iterator.prototype.join.call(5)"#, r#"throws TypeError: Iterator helper requires an object receiver"#),
    (r#"Iterator.prototype.includes.call(5, 1)"#, r#"throws TypeError: Iterator helper requires an object receiver"#),
    (r#"Object.getPrototypeOf(Iterator.from({ next() { return { done: true }; } })).next.call(1)"#, r#"throws TypeError: Iterator wrapper next requires an iterator wrapper"#),
    (r#"Object.getPrototypeOf(Iterator.from({ next() { return { done: true }; } })).next.call({})"#, r#"throws TypeError: Iterator wrapper next requires an iterator wrapper"#),
    (r#"Object.getPrototypeOf(Iterator.from({ next() { return { done: true }; } })).return.call(1)"#, r#"throws TypeError: Iterator wrapper return requires an iterator wrapper"#),
    (r#"Object.getPrototypeOf(Iterator.from({ next() { return { done: true }; } })).return.call({})"#, r#"throws TypeError: Iterator wrapper return requires an iterator wrapper"#),
    (r#"Iterator.zip([[1].values()], { mode: 'longest', padding: 5 })"#, r#"throws TypeError: Iterator.zip padding must be an object"#),
    (r#"Iterator.zip([[1].values()], { mode: 'longest', padding: {} })"#, r#"throws TypeError: Iterator.zip padding must be iterable"#),
    (r#"Iterator.zip([[1].values()], { mode: 'longest', padding: { [Symbol.iterator]() { return 5; } } })"#, r#"throws TypeError: Iterator.zip padding iterator must return an object"#),
    (r#"Iterator.zip([[1, 2].values(), [3].values()], { mode: 'longest', padding: [7] }).toArray().join('|')"#, r#"1,3|2,"#),
    (r#"Iterator.zip([[1, 2].values(), [3].values()], { mode: 'longest', padding: [7, 8, 9] }).toArray().join('|')"#, r#"1,3|2,8"#),
    (r#"Iterator.zip([[1].values()], { mode: 'longest' }).toArray().join('|')"#, r#"1"#),
    (r#"Iterator.zip([[1].values(), 5]).next()"#, r#"throws TypeError: Iterator.flatMap mapper must return an object"#),
    (r#"Iterator.zipKeyed(new Proxy({}, { ownKeys() { return ['a']; } })).toArray().length"#, r#"0"#),
    (r#"Iterator.zipKeyed(Object.defineProperty({ a: [1].values() }, 'h', { value: [2].values(), enumerable: false })).toArray().length"#, r#"1"#),
    (r#"Iterator.zipKeyed({ a: [1, 2].values(), b: undefined, c: [3].values() }, { mode: 'longest', padding: { a: 0, c: 9 } }).toArray().map(x => JSON.stringify(x)).join('|')"#, r#"{"a":1,"c":3}|{"a":2,"c":9}"#),
    (r#"Iterator.zipKeyed({ a: [1].values() }, { mode: 'longest' }).toArray().length"#, r#"1"#),
    (r#"Iterator.zipKeyed({ a: [1].values() }, { mode: 'longest', padding: 5 })"#, r#"throws TypeError: Iterator.zip padding must be an object"#),
    (r#"Iterator.zip([[1].values(), [2].values(), [3].values()], { mode: 'longest', padding: [0] }).toArray().join('|')"#, r#"1,2,3"#),
    (r#"Iterator.zip([{ [Symbol.iterator]() { return 5; } }]).next()"#, r#"throws TypeError: Iterator.flatMap iterator method must return an object"#),
    (r#"Iterator.zipKeyed({ a: { [Symbol.iterator]() { return 5; } } }).next()"#, r#"throws TypeError: Iterator.flatMap iterator method must return an object"#),
];
