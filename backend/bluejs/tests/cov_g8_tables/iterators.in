// Expected results are BlueJS's own.
const ITERATOR_CASES: &[(&str, &str)] = &[
    (r#"[1, 2, 3].values().map(x => x * 2).toArray().join()"#, r#"2,4,6"#),
    (r#"[1, 2, 3].values().filter(x => x > 1).toArray().join()"#, r#"2,3"#),
    (r#"[1, 2, 3].values().take(2).toArray().join()"#, r#"1,2"#),
    (r#"[1, 2, 3].values().drop(1).toArray().join()"#, r#"2,3"#),
    (r#"[1, 2, 3].values().flatMap(x => [x, x]).toArray().join()"#, r#"1,1,2,2,3,3"#),
    (r#"[1, 2, 3].values().reduce((a, b) => a + b, 0)"#, r#"6"#),
    (r#"[1, 2, 3].values().reduce((a, b) => a + b)"#, r#"6"#),
    (r#"[1, 2, 3].values().some(x => x > 2)"#, r#"true"#),
    (r#"[1, 2, 3].values().every(x => x > 2)"#, r#"false"#),
    (r#"[1, 2, 3].values().find(x => x > 1)"#, r#"2"#),
    (r#"[1, 2, 3].values().forEach(x => x)"#, r#"undefined"#),
    (r#"[1, 2, 3].values().chunks(2).toArray().join('|')"#, r#"1,2|3"#),
    (r#"[1, 2, 3].values().windows(2).toArray().join('|')"#, r#"1,2|2,3"#),
    (r#"[1, 2, 3].values().includes(2)"#, r#"true"#),
    (r#"[1, 2, 3].values().join('-')"#, r#"1-2-3"#),
    (r#"Iterator.from({ next() { return { done: true } } }).toArray().length"#, r#"0"#),
    (r#"Iterator.zip([[1, 2].values(), [3, 4].values()]).toArray().join('|')"#, r#"1,3|2,4"#),
    (r#"Iterator.zip([[1, 2].values(), [3].values()], { mode: 'longest', padding: [0, 9] }).toArray().join('|')"#, r#"1,3|2,9"#),
    (r#"Iterator.zip([[1, 2].values(), [3].values()], { mode: 'strict' }).toArray().join('|')"#, r#"throws TypeError: Iterator.zip strict sources have different lengths"#),
    (r#"Iterator.zipKeyed({ a: [1, 2].values(), b: [3, 4].values() }).toArray().map(x => JSON.stringify(x)).join('|')"#, r#"{"a":1,"b":3}|{"a":2,"b":4}"#),
    (r#"Iterator.concat([1].values(), [2].values()).toArray().join()"#, r#"1,2"#),
    (r#"[1, 2, 3].values().take(-1)"#, r#"throws RangeError: invalid Iterator.take limit"#),
    (r#"[1, 2, 3].values().take(NaN)"#, r#"throws RangeError: invalid Iterator.take limit"#),
    (r#"[1, 2, 3].values().chunks(0)"#, r#"throws RangeError: invalid Iterator.chunks size"#),
    (r#"[1, 2, 3].values().windows(0)"#, r#"throws RangeError: invalid Iterator.windows size"#),
    (r#"[1, 2, 3].values().chunks(2 ** 32)"#, r#"throws RangeError: invalid Iterator.chunks size"#),
    (r#"[1, 2, 3].values().map(5)"#, r#"throws TypeError: Iterator helper callback must be callable"#),
    (r#"Iterator.zip([[1].values()], { mode: 'bogus' })"#, r#"throws TypeError: invalid Iterator.zip mode"#),
    (r#"Iterator.zip(5)"#, r#"throws TypeError: Iterator.zip iterables must be an object"#),
    (r#"Iterator.zipKeyed(5)"#, r#"throws TypeError: Iterator.zipKeyed iterables must be an object"#),
    (r#"Iterator.concat(5)"#, r#"throws TypeError: Iterator.concat requires object arguments"#),
    (r#"Iterator.from(5)"#, r#"throws TypeError: Iterator.from requires an object or String"#),
    (r#"Iterator.from('abc').toArray().join()"#, r#"a,b,c"#),
];
