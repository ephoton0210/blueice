// Expected results shared by the integration test of the same name and the
// in-crate `vm::functions::reference_tables` test.
const COLL_CASES: &[(&str, &str)] = &[
    ("JSON.stringify(Object.groupBy([1, 2, 3, 4], x => x % 2 ? 'odd' : 'even'))", "{\"odd\":[1,3],\"even\":[2,4]}"),
    ("JSON.stringify(Object.groupBy('abc', (c, i) => i))", "{\"0\":[\"a\"],\"1\":[\"b\"],\"2\":[\"c\"]}"),
    ("JSON.stringify(Object.groupBy(new Set([1, 2]), x => x))", "{\"1\":[1],\"2\":[2]}"),
    ("Object.groupBy([1], 5)", "throws TypeError"),
    ("Object.groupBy(null, x => x)", "throws TypeError"),
    ("Object.groupBy(undefined, x => x)", "throws TypeError"),
    ("Object.groupBy(5, x => x)", "throws TypeError"),
    ("Object.groupBy({ [Symbol.iterator]: 5 }, x => x)", "throws TypeError"),
    ("Object.groupBy({ [Symbol.iterator]() { return 5 } }, x => x)", "throws TypeError"),
    ("Object.groupBy({ [Symbol.iterator]() { throw new EvalError('it') } }, x => x)", "throws EvalError"),
    ("Object.groupBy({ [Symbol.iterator]() { return { next() { throw new EvalError('next') } } } }, x => x)", "throws EvalError"),
    ("Object.groupBy({ [Symbol.iterator]() { return { next() { return 5 } } } }, x => x)", "throws TypeError"),
    ("Object.groupBy([1], () => { throw new EvalError('cb') })", "throws EvalError"),
    ("Object.groupBy([1], () => ({ toString() { throw new EvalError('key') } }))", "throws EvalError"),
    ("Object.groupBy([1], () => Symbol())", "throws TypeError"),
    ("(function () { var closed = 0; try { Object.groupBy({ [Symbol.iterator]() { return { next() { return { value: 1, done: false } }, return() { closed++; return {} } } } }, () => { throw new EvalError('cb') }) } catch (e) { return e.message + closed } })()", "cb1"),
    ("(function () { var closed = 0; try { Object.groupBy({ [Symbol.iterator]() { return { next() { return { value: 1, done: false } }, return() { closed++; throw new EvalError('close') } } } }, () => { throw new RangeError('cb') }) } catch (e) { return e.constructor.name + closed } })()", "RangeError1"),
    ("JSON.stringify(Object.keys(Object.groupBy([1, 2], x => x % 2 === 0 ? Symbol.for('a') : 'b')).length)", "1"),
    ("Object.getPrototypeOf(Object.groupBy([], x => x))", "null"),
    ("JSON.stringify([...Map.groupBy([1, 2, 3, 4], x => x % 2)])", "[[1,[1,3]],[0,[2,4]]]"),
    ("JSON.stringify([...Map.groupBy('aab', c => c)])", "[[\"a\",[\"a\",\"a\"]],[\"b\",[\"b\"]]]"),
    ("JSON.stringify([...Map.groupBy([1, 2], x => -0)].map(([k]) => Object.is(k, 0)))", "[true]"),
    ("JSON.stringify([...Map.groupBy([1, 2], x => NaN)])", "[[null,[1,2]]]"),
    ("Map.groupBy(null, x => x)", "throws TypeError"),
    ("Map.groupBy(undefined, x => x)", "throws TypeError"),
    ("Map.groupBy([1], 5)", "throws TypeError"),
    ("Map.groupBy(5, x => x)", "throws TypeError"),
    ("Map.groupBy({ [Symbol.iterator]() { throw new EvalError('it') } }, x => x)", "throws EvalError"),
    ("Map.groupBy({ [Symbol.iterator]() { return { next() { throw new EvalError('next') } } } }, x => x)", "throws EvalError"),
    ("Map.groupBy([1], () => { throw new EvalError('cb') })", "throws EvalError"),
    ("(function () { var closed = 0; try { Map.groupBy({ [Symbol.iterator]() { return { next() { return { value: 1, done: false } }, return() { closed++; return {} } } } }, () => { throw new EvalError('cb') }) } catch (e) { return e.message + closed } })()", "cb1"),
    ("Map.groupBy([1], x => x) instanceof Map", "true"),
    ("JSON.stringify(Object.fromEntries([['a', 1], ['b', 2]]))", "{\"a\":1,\"b\":2}"),
    ("JSON.stringify(Object.fromEntries(new Map([[1, 'x'], ['a', 'y']])))", "{\"1\":\"x\",\"a\":\"y\"}"),
    ("JSON.stringify(Object.fromEntries([[Symbol.for('s'), 1]]).constructor === Object)", "true"),
    ("Object.fromEntries()", "throws TypeError"),
    ("Object.fromEntries(null)", "throws TypeError"),
    ("Object.fromEntries(5)", "throws TypeError"),
    ("Object.fromEntries([1])", "throws TypeError"),
    ("Object.fromEntries(['ab'])", "throws TypeError"),
    ("Object.fromEntries([null])", "throws TypeError"),
    ("Object.fromEntries([{ get 0() { throw new EvalError('k') } }])", "throws EvalError"),
    ("Object.fromEntries([{ 0: 'a', get 1() { throw new EvalError('v') } }])", "throws EvalError"),
    ("Object.fromEntries([[{ toString() { throw new EvalError('key') } }, 1]])", "throws EvalError"),
    ("Object.fromEntries([[Symbol(), 1]]) instanceof Object", "true"),
    ("Object.fromEntries({ [Symbol.iterator]() { throw new EvalError('it') } })", "throws EvalError"),
    ("Object.fromEntries({ [Symbol.iterator]() { return { next() { throw new EvalError('next') } } } })", "throws EvalError"),
    ("(function () { var closed = 0; try { Object.fromEntries({ [Symbol.iterator]() { return { next() { return { value: 5, done: false } }, return() { closed++; return {} } } } }) } catch (e) { return e.constructor.name + closed } })()", "TypeError1"),
    ("JSON.stringify(Array.from([1, 2, 3]))", "[1,2,3]"),
    ("JSON.stringify(Array.from([1, 2, 3], x => x * 2))", "[2,4,6]"),
    ("JSON.stringify(Array.from([1, 2, 3], function (x) { return x * this.k }, { k: 3 }))", "[3,6,9]"),
    ("JSON.stringify(Array.from('abc'))", "[\"a\",\"b\",\"c\"]"),
    ("JSON.stringify(Array.from(new Set([1, 2])))", "[1,2]"),
    ("JSON.stringify(Array.from({ length: 2, 0: 'a', 1: 'b' }))", "[\"a\",\"b\"]"),
    ("JSON.stringify(Array.from({ length: 2, 0: 'a', 1: 'b' }, (x, i) => x + i))", "[\"a0\",\"b1\"]"),
    ("JSON.stringify(Array.from({ length: 3 }))", "[null,null,null]"),
    ("JSON.stringify(Array.from({ length: -1 }))", "[]"),
    ("JSON.stringify(Array.from({}))", "[]"),
    ("JSON.stringify(Array.from(5))", "[]"),
    ("JSON.stringify(Array.from(true))", "[]"),
    ("Array.from(null)", "throws TypeError"),
    ("Array.from(undefined)", "throws TypeError"),
    ("Array.from()", "throws TypeError"),
    ("Array.from([], 5)", "throws TypeError"),
    ("Array.from([], null)", "throws TypeError"),
    ("Array.from({ length: 1 }, 5)", "throws TypeError"),
    ("Array.from({ [Symbol.iterator]: 5 })", "throws TypeError"),
    ("Array.from({ get [Symbol.iterator]() { throw new EvalError('g') } })", "throws EvalError"),
    ("Array.from({ [Symbol.iterator]() { return 5 } })", "throws TypeError"),
    ("Array.from({ [Symbol.iterator]() { throw new EvalError('it') } })", "throws EvalError"),
    ("Array.from({ [Symbol.iterator]() { return { next() { throw new EvalError('next') } } } })", "throws EvalError"),
    ("Array.from({ [Symbol.iterator]() { return { next() { return 5 } } } })", "throws TypeError"),
    ("Array.from([1], () => { throw new EvalError('map') })", "throws EvalError"),
    ("Array.from({ length: 1 }, () => { throw new EvalError('map') })", "throws EvalError"),
    ("Array.from({ get length() { throw new EvalError('len') } })", "throws EvalError"),
    ("Array.from({ length: { valueOf() { throw new EvalError('lv') } } })", "throws EvalError"),
    ("Array.from({ length: Symbol() })", "throws TypeError"),
    ("Array.from({ length: 1, get 0() { throw new EvalError('g0') } })", "throws EvalError"),
    ("Array.from.call(function () { throw new EvalError('ctor') }, { length: 0 })", "throws EvalError"),
    ("Array.from.call(function () { throw new EvalError('ctor') }, [])", "throws EvalError"),
    ("Array.from.call(function () { return 5 }, { length: 1 })", "[object Object]"),
    ("Array.from.call(function () { return 5 }, [1])", "[object Object]"),
    ("Array.from.call(5, [1, 2]).length", "2"),
    ("Array.from.call(undefined, [1, 2]).length", "2"),
    ("Array.from.call(Object, [1, 2]) instanceof Object", "true"),
    ("Array.from.call(Object, { length: 2, 0: 1 }).length", "2"),
    ("(function () { function C() { this.made = true } var r = Array.from.call(C, [7, 8]); return JSON.stringify([r.made, r.length, r[0], r[1], r instanceof C]) })()", "[true,2,7,8,true]"),
    ("(function () { function C(n) { this.n = n } var r = Array.from.call(C, { length: 2, 0: 7, 1: 8 }); return JSON.stringify([r.n, r.length, r[0], r[1]]) })()", "[2,2,7,8]"),
    ("(function () { var closed = 0; try { Array.from({ [Symbol.iterator]() { return { next() { return { value: 1, done: false } }, return() { closed++; return {} } } } }, () => { throw new EvalError('map') }) } catch (e) { return e.message + closed } })()", "map1"),
    ("(function () { var closed = 0; try { Array.from({ [Symbol.iterator]() { return { next() { return { value: 1, done: false } }, return() { closed++; throw new RangeError('close') } } } }, () => { throw new EvalError('map') }) } catch (e) { return e.constructor.name + closed } })()", "EvalError1"),
    ("(function () { try { Array.from.call(function () { Object.defineProperty(this, '0', { value: 0, writable: false, configurable: false }) }, [1]) } catch (e) { return e.constructor.name } })()", "TypeError"),
    ("(function () { try { Array.from.call(function () { Object.defineProperty(this, '0', { value: 0, writable: false, configurable: false }) }, { length: 1, 0: 1 }) } catch (e) { return e.constructor.name } })()", "TypeError"),
    ("(function () { try { Array.from.call(function () { Object.defineProperty(this, 'length', { value: 0, writable: false }) }, { length: 0 }) } catch (e) { return e.constructor.name } })()", "TypeError"),
    ("(function () { try { Array.from.call(function () { Object.defineProperty(this, 'length', { value: 0, writable: false }) }, []) } catch (e) { return e.constructor.name } })()", "TypeError"),
    ("(function () { var log = []; Array.from({ length: 2, get 0() { log.push('g0'); return 1 }, get 1() { log.push('g1'); return 2 } }, x => { log.push('m' + x); return x }); return log.join() })()", "g0,m1,g1,m2"),
    ("JSON.stringify(Array.from(new Proxy([1, 2], {})))", "[1,2]"),
    ("JSON.stringify(Array.from({ [Symbol.iterator]: function* () { yield 1; yield 2 } }))", "[1,2]"),
    ("JSON.stringify(Array.of(1, 2, 3))", "[1,2,3]"),
    ("JSON.stringify(Array.of())", "[]"),
    ("JSON.stringify(Array.of(undefined))", "[null]"),
    ("Array.of.call(function () { throw new EvalError('ctor') }, 1)", "throws EvalError"),
    ("Array.of.call(function () { return 5 }, 1)", "[object Object]"),
    ("(function () { function C(n) { this.n = n } var r = Array.of.call(C, 7, 8); return JSON.stringify([r.n, r.length, r[0], r[1]]) })()", "[2,2,7,8]"),
    ("Array.of.call(5, 1).length", "1"),
    ("Array.of.call(undefined, 1, 2).length", "2"),
    ("(function () { try { Array.of.call(function () { Object.defineProperty(this, '0', { value: 0, writable: false, configurable: false }) }, 1) } catch (e) { return e.constructor.name } })()", "TypeError"),
    ("(function () { try { Array.of.call(function () { Object.defineProperty(this, 'length', { value: 0, writable: false }) }, 1) } catch (e) { return e.constructor.name } })()", "TypeError"),
    ("Array.of.call(Object, 1, 2) instanceof Object", "true"),
    ("JSON.stringify([...new Map([[1, 2], [3, 4]])])", "[[1,2],[3,4]]"),
    ("JSON.stringify([...new Map([[1, 2], [3, 4]]).keys()])", "[1,3]"),
    ("JSON.stringify([...new Map([[1, 2], [3, 4]]).values()])", "[2,4]"),
    ("JSON.stringify([...new Map([[1, 2], [3, 4]]).entries()])", "[[1,2],[3,4]]"),
    ("JSON.stringify([...new Set([1, 2, 3])])", "[1,2,3]"),
    ("JSON.stringify([...new Set([1, 2, 3]).entries()])", "[[1,1],[2,2],[3,3]]"),
    ("JSON.stringify([...new Set([1, 2, 3]).values()])", "[1,2,3]"),
    ("JSON.stringify([...new Set([1, 2, 3]).keys()])", "[1,2,3]"),
    ("(function () { var out = []; new Map([[1, 'a'], [2, 'b']]).forEach(function (v, k, m) { out.push(k + v + (m instanceof Map) + this.t) }, { t: '!' }); return out.join() })()", "1atrue!,2btrue!"),
    ("(function () { var out = []; new Set([1, 2]).forEach((v, k, s) => out.push(v + ':' + k)); return out.join() })()", "1:1,2:2"),
    ("(function () { var m = new Map([[1, 1]]); var out = []; m.forEach((v, k) => { out.push(k); if (k < 4) m.set(k + 1, 1) }); return out.join() })()", "1,2,3,4"),
    ("(function () { var m = new Map([[1, 1], [2, 2]]); var out = []; m.forEach((v, k) => { out.push(k); m.delete(2) }); return out.join() })()", "1"),
    ("(function () { var s = new Set([1]); var out = []; s.forEach(v => { out.push(v); if (v < 3) s.add(v + 1) }); return out.join() })()", "1,2,3"),
    ("new Map().forEach(5)", "throws TypeError"),
    ("new Set().forEach(5)", "throws TypeError"),
    ("new Map().forEach()", "throws TypeError"),
    ("new Map([[1, 1]]).forEach(() => { throw new EvalError('cb') })", "throws EvalError"),
    ("Map.prototype.forEach.call({}, () => {})", "throws TypeError"),
    ("Set.prototype.forEach.call({}, () => {})", "throws TypeError"),
    ("Map.prototype.keys.call({})", "throws TypeError"),
    ("Set.prototype.values.call({})", "throws TypeError"),
    ("Map.prototype.entries.call(new Set())", "throws TypeError"),
    ("Set.prototype.entries.call(new Map())", "throws TypeError"),
    ("(function () { var it = new Map([[1, 2]])[Symbol.iterator](); it.next(); it.next(); return JSON.stringify(it.next()) })()", "{\"done\":true}"),
    ("(function () { var it = new Set([1])[Symbol.iterator](); it.next(); return JSON.stringify(it.next()) + JSON.stringify(it.next()) })()", "{\"done\":true}{\"done\":true}"),
    ("(function () { var m = new Map([[1, 2]]); var it = m.keys(); m.set(3, 4); return JSON.stringify([...it]) })()", "[1,3]"),
    ("(function () { var m = new Map([[1, 2], [3, 4]]); var it = m.keys(); it.next(); m.delete(3); return JSON.stringify(it.next()) })()", "{\"done\":true}"),
    ("Object.prototype.toString.call(new Map().keys())", "[object Map Iterator]"),
    ("Object.prototype.toString.call(new Set().values())", "[object Set Iterator]"),
    ("Map.prototype.keys.call(new Map()).next.call({})", "throws TypeError"),
    ("Set.prototype.values.call(new Set()).next.call(new Map().keys())", "throws TypeError"),
    ("Map.prototype.keys.call(new Map()).next.call(5)", "throws TypeError"),
    ("Object.getPrototypeOf(new Map().keys()) === Object.getPrototypeOf(new Map().values())", "true"),
    ("Object.getPrototypeOf(new Map().keys()) === Object.getPrototypeOf(new Set().values())", "false"),
    ("typeof Object.getPrototypeOf(new Map().keys()).next", "function"),
    ("JSON.stringify([...[1, 2].entries()])", "[[0,1],[1,2]]"),
    ("JSON.stringify([...[1, 2].keys()])", "[0,1]"),
    ("JSON.stringify([...['a'].values()])", "[\"a\"]"),
    ("Object.prototype.toString.call([].entries())", "[object Array Iterator]"),
    ("[].entries().next.call({})", "throws TypeError"),
    ("[].entries().next.call(new Map().keys())", "throws TypeError"),
    ("Array.prototype.entries.call(null)", "throws TypeError"),
    ("JSON.stringify([...Array.prototype.entries.call({ length: 2, 0: 'x', 1: 'y' })])", "[[0,\"x\"],[1,\"y\"]]"),
    ("JSON.stringify([...Array.prototype.keys.call('ab')])", "[0,1]"),
    ("JSON.stringify([...new Uint8Array([5, 6]).entries()])", "[[0,5],[1,6]]"),
    ("JSON.stringify([...'ab'[Symbol.iterator]()])", "[\"a\",\"b\"]"),
];
