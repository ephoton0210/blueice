// Expected results shared by the integration test of the same name and the
// in-crate `vm::functions::reference_tables` test.
const FN_CASES: &[(&str, &str)] = &[
    ("(function () { var p = Proxy.revocable(function () {}, {}); p.revoke(); return Function.prototype.bind.call(p.proxy) })()", "throws TypeError"),
    ("Function.prototype.bind.call(new Proxy(function () {}, { getOwnPropertyDescriptor() { throw new EvalError('gopd') } }))", "throws EvalError"),
    ("Function.prototype.bind.call(new Proxy(function () {}, { get(target, key) { if (key === 'length') throw new EvalError('length'); return target[key] } }))", "throws EvalError"),
    ("Function.prototype.bind.call(new Proxy(function () {}, { get(target, key) { if (key === 'name') throw new EvalError('name'); return target[key] } }))", "throws EvalError"),
    ("Function.prototype.bind.call({})", "throws TypeError"),
    ("Function.prototype.bind.call(5)", "throws TypeError"),
    ("Function.prototype.bind.call(undefined)", "throws TypeError"),
    ("(function (a, b) { }).bind(null, 1).length", "1"),
    ("(function (a, b) { }).bind(null, 1, 2, 3).length", "0"),
    ("(function () { }).bind().name", "bound "),
    ("Object.defineProperty(function () { }, 'length', { value: -5 }).bind().length", "0"),
    ("Object.defineProperty(function () { }, 'length', { value: Infinity }).bind().length", "Infinity"),
    ("Object.defineProperty(function () { }, 'length', { value: NaN }).bind().length", "0"),
    ("Object.defineProperty(function () { }, 'length', { value: '3' }).bind().length", "0"),
    ("Object.defineProperty(function () { }, 'name', { value: 5 }).bind().name", "bound "),
    ("Object.defineProperty(function () { }, 'name', { value: 'x' }).bind().name", "bound x"),
    ("(function () { var f = function () { }; delete f.length; return f.bind().length })()", "0"),
    ("(function () { class C { } return C.bind().name })()", "bound C"),
    ("new ((function () { this.a = 1 }).bind())().a", "1"),
    ("new (Math.max.bind())() ", "throws TypeError"),
    ("5 instanceof Function", "false"),
    ("({}) instanceof Function", "false"),
    ("(function () { }) instanceof Function", "true"),
    ("({}) instanceof (function () { }).bind()", "false"),
    ("new (function F() { }).bind()() instanceof (function () { })", "throws TypeError"),
    ("(function () { function F() { } return new F() instanceof F.bind() })()", "true"),
    ("({}) instanceof 5", "throws TypeError"),
    ("({}) instanceof {}", "throws TypeError"),
    ("({}) instanceof { [Symbol.hasInstance]: 5 }", "throws TypeError"),
    ("({}) instanceof { [Symbol.hasInstance]() { return 1 } }", "true"),
    ("({}) instanceof { [Symbol.hasInstance]() { throw new EvalError('hi') } }", "throws EvalError"),
    ("({}) instanceof { get [Symbol.hasInstance]() { throw new EvalError('get') } }", "throws EvalError"),
    ("({}) instanceof new Proxy(function () { }, { get(target, key) { if (key === 'prototype') throw new EvalError('pt'); return target[key] } })", "throws EvalError"),
    ("({}) instanceof new Proxy(function () { }, { get(target, key) { return key === 'prototype' ? 5 : target[key] } })", "throws TypeError"),
    ("new Proxy({}, { getPrototypeOf() { throw new EvalError('gpo') } }) instanceof Object", "throws EvalError"),
    ("new Proxy({}, { getPrototypeOf() { return Array.prototype } }) instanceof Array", "true"),
    ("Object.create(Object.create(Object.create(Array.prototype))) instanceof Array", "true"),
    ("Object.create(Object.create(Object.create(null))) instanceof Array", "false"),
    ("Function.prototype[Symbol.hasInstance].call(function () { }, {})", "false"),
    ("Function.prototype[Symbol.hasInstance].call(5, {})", "false"),
    ("Function.prototype[Symbol.hasInstance].call({}, {})", "false"),
    ("Function.prototype[Symbol.hasInstance].call((function () { }).bind(), {})", "false"),
    ("Function.prototype[Symbol.hasInstance].call(Object, {})", "true"),
    ("Function.prototype[Symbol.hasInstance].call(Object, 5)", "false"),
    ("(function () { var p = Proxy.revocable(function () { }, {}); p.revoke(); return ({}) instanceof p.proxy })()", "throws TypeError"),
];
