// Expected results shared by the integration test of the same name and the
// in-crate `vm::functions::reference_tables` test.
const CASES: &[(&str, &str)] = &[
    (r#"$262.IsHTMLDDA('x')"#, r#"undefined"#),
    (r#"$262.IsHTMLDDA()"#, r#"null"#),
    (r#"$262.IsHTMLDDA('')"#, r#"null"#),
    (
        r#"$262.detachArrayBuffer({})"#,
        r#"throws TypeError: BlueJS object lacks the required internal slot:"#,
    ),
    (
        r#"$262.detachArrayBuffer(5)"#,
        r#"throws TypeError: detachArrayBuffer requires an ArrayBuffer"#,
    ),
    (
        r#"$262.detachArrayBuffer(new ArrayBuffer(4).transferToImmutable())"#,
        r#"throws TypeError: ArrayBuffer is immutable"#,
    ),
    (
        r#"(function () { var ab = new ArrayBuffer(8); $262.detachArrayBuffer(ab); $262.detachArrayBuffer(ab); return ab.detached })()"#,
        r#"true"#,
    ),
    (
        r#"setTimeout(5, 0)"#,
        r#"throws TypeError: setTimeout callback must be callable"#,
    ),
    (
        r#"setTimeout({}, 0)"#,
        r#"throws TypeError: setTimeout callback must be callable"#,
    ),
    (
        r#"setTimeout(function () {}, { valueOf() { throw new EvalError('v') } })"#,
        r#"throws EvalError: v"#,
    ),
    (r#"setTimeout(function () {}, -1)"#, r#"0"#),
    (r#"setTimeout(function () {}, Infinity)"#, r#"0"#),
    (r#"setTimeout(function () {}, 1)"#, r#"0"#),
