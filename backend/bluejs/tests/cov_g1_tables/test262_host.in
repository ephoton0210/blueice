    ),
    (
        r#"buildString({ loneCodePoints: [], ranges: [[1]] })"#,
        r#"throws TypeError: buildString ranges require a start and end"#,
    ),
    (
        r#"buildString({ loneCodePoints: [], ranges: [[5, 1]] })"#,
        r#"throws RangeError: buildString range start exceeds end"#,
    ),
    (
        r#"buildString({ loneCodePoints: [-1], ranges: [] })"#,
        r#"throws RangeError: invalid code point for String.fromCodePoint"#,
    ),
    (
        r#"buildString({ loneCodePoints: [1.5], ranges: [] })"#,
        r#"throws RangeError: invalid code point for String.fromCodePoint"#,
    ),
    (
        r#"buildString({ loneCodePoints: [NaN], ranges: [] })"#,
        r#"throws RangeError: invalid code point for String.fromCodePoint"#,
    ),
    (
        r#"buildString({ loneCodePoints: [0x110000], ranges: [] })"#,
        r#"throws RangeError: invalid code point for String.fromCodePoint"#,
    ),
    (
        r#"buildString({ loneCodePoints: [{ valueOf() { throw new EvalError('v') } }], ranges: [] })"#,
        r#"throws EvalError: v"#,
    ),
    (
        r#"buildString({ get loneCodePoints() { throw new EvalError('g') }, ranges: [] })"#,
        r#"throws EvalError: g"#,
    ),
    (
        r#"buildString({ loneCodePoints: [], get ranges() { throw new EvalError('g') } })"#,
        r#"throws EvalError: g"#,
    ),
    (
        r#"buildString({ loneCodePoints: 5, ranges: [] })"#,
        r#"throws TypeError: argument list must be an object"#,
    ),
    (
        r#"buildString({ loneCodePoints: [], ranges: 5 })"#,
        r#"throws TypeError: argument list must be an object"#,
    ),
    (
        r#"buildString({ loneCodePoints: [], ranges: [5] })"#,
        r#"throws TypeError: argument list must be an object"#,
    ),
    (
        r#"buildString({ loneCodePoints: [], ranges: [[{ valueOf() { throw new EvalError('s') } }, 1]] })"#,
        r#"throws EvalError: s"#,
    ),
    (
        r#"buildString({ loneCodePoints: [], ranges: [[1, { valueOf() { throw new EvalError('e') } }]] })"#,
        r#"throws EvalError: e"#,
    ),
    (r#"testPropertyEscapes(/a/u, 'a')"#, r#"undefined"#),
    (
        r#"testPropertyEscapes(/a/u, 'b')"#,
        r#"throws Test262Error: testPropertyEscapes failed"#,
    ),
    (
        r#"testPropertyEscapes({ test: 5 }, 'a')"#,
        r#"throws TypeError: value is not callable"#,
    ),
    (
        r#"testPropertyEscapes({ get test() { throw new EvalError('t') } }, 'a')"#,
        r#"throws EvalError: t"#,
    ),
    (
        r#"testPropertyEscapes({ test() { throw new EvalError('c') } }, 'a')"#,
