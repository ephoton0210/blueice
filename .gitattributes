# Generated declaration and manifest artifacts are compared byte for byte with
# freshly generated output and verified by hash. Keep LF on every platform so a
# Windows checkout with core.autocrlf=true does not turn them into CRLF.
lib.blueice.d.ts text eol=lf
lib.blueice.manifest.json text eol=lf
backend/core/engine/tests/fixtures/host_typings/** text eol=lf

# K.3/K.13 diagnostic references record raw UTF-16 offsets from LF sources.
# Pin both complete input corpora so Windows checkout cannot shift those spans
# or the K.3.3 type-fact witness digests before the pinned compiler reads them.
backend/bluets/tests/fixtures/typescript_oracle/** text eol=lf
backend/bluets/tests/fixtures/strictness/** text eol=lf

# K.7.3 native diagnostics and source-content digests depend on fixture bytes.
backend/bluets/tests/fixtures/output_options/** text eol=lf

# K.7.2 native diagnostic offsets and fixture observations use original LF bytes.
backend/bluets/tests/fixtures/module_systems/** text eol=lf
backend/bluets/tests/fixtures/output_validation/** text eol=lf

# K.7.4 records native source digests and UTF-16 diagnostic origins.
backend/bluets/tests/fixtures/decorator_targets/** text eol=lf

backend/bluets/tests/fixtures/decorator_residuals/** text eol=lf

# Native inferred-declaration primary offsets and recorded source hashes use LF.
backend/bluets/tests/fixtures/declaration_inference/** text eol=lf

backend/bluets/tests/fixtures/declaration_options/** text eol=lf

backend/bluets/tests/fixtures/package_extras/** text eol=lf

# K.9.2 Native path/type resolution observations retain LF bytes.
backend/bluets/tests/fixtures/path_extras/** text eol=lf

# K.9.3 Native JSON/JavaScript observations retain LF bytes.
backend/bluets/tests/fixtures/source_extras/** text eol=lf
backend/bluets/tests/fixtures/jsx_typing_extras/** text eol=lf
backend/bluets/tests/fixtures/jsx_runtime_namespace/** text eol=lf
backend/bluets/tests/fixtures/decorator_typing/** text eol=lf

# K.11 freezes LF source-map fixtures; the CRLF+astral row is synthesized by
# the oracle from its LF source so Windows checkout cannot change map positions.
backend/bluets/tests/fixtures/k11_source_maps/** text eol=lf

# The System wrapper embeds this JavaScript verbatim; CRLF checkout shifts its
# generated-position source map and exposes user provenance on the wrapper.
backend/bluets/src/emitter/system_helpers.v1.js text eol=lf
